# ──────────────────────────────────────────────────────────────────────────────
# DiplomShop — единая точка конфигурации для всех сервисов
# Меняешь значения здесь, перезапускаешь docker-compose — все сервисы подхватят.
# Файл читается docker-compose автоматически из текущей директории.
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_SHOP=diplom_shop
MONGO_DB_TESTS=diplom_tests
MONGO_DB_DEMOGRAPHICS=diplom_demographics
MONGO_DB_NOTIFICATIONS=diplom_notifications

# ── Kafka ────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── MinIO / S3 ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=diplom-shop
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Внутренние URL сервисов (Docker-сеть) ────────────────────────────────
SHOP_URL=http://app:8080
TEST_SERVICE_URL=http://test-service:8081
SELECTOR_SERVICE_URL=http://selector-service:8082
NOTIFICATION_SERVICE_URL=http://notification-service:8083
DEMOGRAPHIC_SERVICE_URL=http://demographic-service:8084

# ── Test-service админ-доступ (HTTP Basic) ───────────────────────────────
TEST_SERVICE_ADMIN_USERNAME=admin
TEST_SERVICE_ADMIN_PASSWORD=Admin1234!

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=fsdfdsfsdf76@gmail.com
MAIL_PASSWORD=ghkgceicszvnfrpk
MAIL_FROM=fsdfdsfsdf76@gmail.com

# ── Telegram бот ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=7466629748:AAHs2TfX8KJtPzJJIsFIRMSlaDYWsgijb4g
TELEGRAM_ADMIN_CHAT_IDS=787209390

# ── AI (Groq, бесплатный tier) ───────────────────────────────────────────
GROQ_API_KEY=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

# ── n8n ──────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_TIMEZONE=Europe/Moscow

# ── Notifications toggle ─────────────────────────────────────────────────
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_TELEGRAM_ENABLED=true

# ── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
