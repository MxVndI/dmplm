# .env.example — copy to .env and fill in real values
# Alternatively, export these as environment variables or edit application.yml directly.

# MongoDB
MONGO_URI=mongodb://localhost:27017/diplom_shop

# Server
SERVER_PORT=8080

# ── S3 Storage ─────────────────────────────────────────────────────────────
# Option A: MinIO (self-hosted)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=diplom-shop
S3_PUBLIC_URL=http://localhost:9000

# Option B: AWS S3 (leave S3_ENDPOINT and S3_PUBLIC_URL empty)
# S3_ENDPOINT=
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION=eu-central-1
# S3_BUCKET=your-bucket-name
# S3_PUBLIC_URL=

# Option C: Yandex Object Storage
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY=<your-access-key>
# S3_SECRET_KEY=<your-secret-key>
# S3_REGION=ru-central1
# S3_BUCKET=your-bucket-name
# S3_PUBLIC_URL=https://storage.yandexcloud.net
