      "id": "node-poll-schedule",
      "name": "Poll Every 5s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst offset = staticData.telegramOffset ?? 0;\nreturn [{ json: { offset: String(offset) } }];"
      },
      "id": "node-prepare-offset",
      "name": "Prepare Offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -980,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/getUpdates?offset=' + $json.offset + '&limit=10&timeout=0' }}",
        "options": {}
      },
      "id": "node-get-updates",
      "name": "Get Telegram Updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -760,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst updates = body.result ?? [];\nif (!updates.length) return [];\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.telegramOffset = updates[updates.length - 1].update_id + 1;\n\nconst results = [];\nfor (const upd of updates) {\n  const msg = upd.message;\n  if (!msg || !msg.text) continue;\n  const chatId = String(msg.chat.id);\n  const text   = msg.text.trim();\n  const parts  = text.split(/\\s+/);\n  const cmd    = parts[0].toLowerCase();\n\n  if (cmd === '/start') {\n    results.push({ json: { action: 'reply', chatId, text: '👋 DiplomShop Bot\\n\\nAvailable commands:\\n/metrics <testId> — AI analysis of A/B test\\n/test_summary <testId> — raw metrics\\n/link <phone> — link your phone to your account\\n/start_test <testId> — activate a test\\n/stop_test <testId> — deactivate a test' } });\n  } else if (cmd === '/metrics' && parts[1]) {\n    results.push({ json: { action: 'ai_metrics', chatId, testId: parts[1] } });\n  } else if (cmd === '/test_summary' && parts[1]) {\n    results.push({ json: { action: 'raw_metrics', chatId, testId: parts[1] } });\n  } else if (cmd === '/link' && parts[1]) {\n    results.push({ json: { action: 'link_phone', chatId, phone: parts[1] } });\n  } else if (cmd === '/start_test' && parts[1]) {\n    results.push({ json: { action: 'start_test', chatId, testId: parts[1] } });\n  } else if (cmd === '/stop_test' && parts[1]) {\n    results.push({ json: { action: 'stop_test', chatId, testId: parts[1] } });\n  } else if (text.startsWith('/')) {\n    results.push({ json: { action: 'reply', chatId, text: '❓ Unknown command. Send /start for help.' } });\n  }\n}\nreturn results;"
      },
      "id": "node-parse-commands",
      "name": "Parse Commands",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
