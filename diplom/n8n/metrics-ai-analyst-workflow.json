    {
      "parameters": {
        "url": "={{ $env.SHOP_BASE_URL + '/api/metrics/test/' + $json.testId }}",
        "options": {}
      },
      "id": "node-fetch-metrics",
      "name": "Fetch Metrics from Shop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const metricsData = $input.first().json;\nconst variants = metricsData.variants ?? [];\n\nlet summary = `A/B Test Report — Test ID: ${metricsData.testId}\\nTotal events: ${metricsData.totalEvents}\\n\\n`;\nfor (const v of variants) {\n  summary += `=== Variant ${v.variant} ===\\n`;\n  summary += `  Unique users:   ${v.uniqueUserCount}\\n`;\n  summary += `  Page views:     ${v.pageViews}\\n`;\n  summary += `  Clicks:         ${v.clicks}\\n`;\n  if (v.avgScrollDepth != null) summary += `  Avg scroll:     ${v.avgScrollDepth.toFixed(1)}%\\n`;\n  if (v.avgSessionMs != null)   summary += `  Avg time/page:  ${(v.avgSessionMs/1000).toFixed(1)}s\\n`;\n  summary += `  Orders:         ${v.orders ?? 0}\\n`;\n  if (v.orderRevenue != null)   summary += `  Revenue:        $${v.orderRevenue}\\n`;\n  if (v.uniqueUserCount > 0 && v.orderUsers != null)\n    summary += `  Conversion:     ${((v.orderUsers / v.uniqueUserCount) * 100).toFixed(1)}%\\n`;\n  if (v.topPages && v.topPages.length)\n    summary += `  Top pages:      ${v.topPages.slice(0,3).map(p => p.page + '×' + p.count).join(', ')}\\n`;\n  summary += `\\n`;\n}\n\nreturn [{ json: {\n  chatId:  $('node-parse-commands').first().json.chatId,\n  testId:  metricsData.testId,\n  summary,\n  metricsData\n} }];"
      },
      "id": "node-format-for-ai",
      "name": "Format Metrics Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        80
      ]
    },
    {
      "parameters": {
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', messages: [ { role: 'system', content: 'You are a UX analyst expert in A/B testing for e-commerce shops. Analyse the provided metrics and give actionable concise conclusions in 3-5 bullet points. Focus on: which variant performed better, key behavioural differences, conversion impact, and recommendations. Answer in the same language as the metrics data (Russian/English ok).' }, { role: 'user', content: 'Here are the A/B test metrics:\\n\\n' + $json.summary } ], max_tokens: 600, temperature: 0.3 }) }}",
        "options": {}
      },
      "id": "node-openai-analysis",
      "name": "OpenAI AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const openaiResponse = $input.first().json;\nconst metricsNode = $('node-format-for-ai').first().json;\nconst aiText = openaiResponse.choices?.[0]?.message?.content ?? 'AI analysis unavailable.';\n\nconst out = `📊 *A/B Test Analysis*\\n\\n*Raw Summary:*\\n${metricsNode.summary}\\n🤖 *AI Insights:*\\n${aiText}`;\n\nreturn [{ json: { chatId: metricsNode.chatId, text: out } }];"
      },
      "id": "node-compose-ai-reply",
      "name": "Compose AI Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        80
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SHOP_BASE_URL + '/api/metrics/test/' + $json.testId }}",
        "options": {}
      },
      "id": "node-fetch-raw-metrics",
      "name": "Fetch Raw Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst variants = (data.variants ?? []).map(v =>\n  `Variant ${v.variant}: ${v.uniqueUserCount} users, ${v.pageViews} views, ${v.clicks} clicks, ${v.orders ?? 0} orders`\n).join('\\n');\nconst chatId = $('node-parse-commands').first().json.chatId;\nconst text = `📈 Raw Metrics — Test ${data.testId}\\nTotal: ${data.totalEvents} events\\n\\n${variants}`;\nreturn [{ json: { chatId, text } }];"
      },
