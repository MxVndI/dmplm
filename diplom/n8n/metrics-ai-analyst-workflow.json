    {
      "parameters": {
        "jsCode": "const user = $input.first().json;\nconst chatId = $('node-parse-commands').first().json.chatId;\n\nif (!user || !user.id) {\n  return [{ json: { chatId, text: '❌ No account found with that phone number. Please check and try again.' } }];\n}\n\n// If already linked, just confirm\nif (user.telegramChatId && user.telegramChatId === chatId) {\n  return [{ json: { chatId, text: '✅ Your Telegram is already linked to account: ' + user.login, skip_link: true } }];\n}\n\nreturn [{ json: { chatId, userId: user.id, login: user.login, skip_link: false } }];"
      },
